# Copy this file to .env in the repo root, then fill in the values below.
# `make check` verifies these before anything else runs.

# --- OpenAI (required) ---------------------------------------------------
# Key from https://platform.openai.com/api-keys. LLM_MODEL picks the model (default gpt-4o-mini).
OPENAI_API_KEY=

# --- Slack (required for the live demo) --------------------------------------
# Bot User OAuth Token (starts with xoxb-) — OAuth & Permissions in your Slack app
SLACK_BOT_TOKEN=
# App-Level Token with connections:write (starts with xapp-) — Basic Information
SLACK_APP_TOKEN=

# --- Dashboard logins ---------------------------------------------------------
# JSON file holding dashboard users (hashed passwords). Created by `make create-user`.
# USERS_FILE=data/users.json

# --- Dashboard auth ------------------------------------------------------------
# Off by default (the API listens on localhost). Turn on + set a real
# SESSION_SECRET before exposing the dashboard beyond your own machine.
DASHBOARD_AUTH=false
SESSION_SECRET=changeme-session-secret
