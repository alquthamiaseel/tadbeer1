# Copy this file to .env in the repo root, then fill in the values below.
# `make check` verifies these before anything else runs.

# --- Gemini (required) -------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Slack (required for the live demo) --------------------------------------
# Bot User OAuth Token (starts with xoxb-) — OAuth & Permissions in your Slack app
SLACK_BOT_TOKEN=
# App-Level Token with connections:write (starts with xapp-) — Basic Information
SLACK_APP_TOKEN=

# --- Database (required) ------------------------------------------------------
# Matches docker-compose.yml's default Postgres. Only used for dashboard logins.
DATABASE_URL=postgresql+asyncpg://pmfyp:pmfyp@localhost:5433/pmfyp

# --- Dashboard auth ------------------------------------------------------------
# Off by default (the API listens on localhost). Turn on + set a real
# SESSION_SECRET before exposing the dashboard beyond your own machine.
DASHBOARD_AUTH=false
SESSION_SECRET=changeme-session-secret

# --- Not needed for Phase 1 ---------------------------------------------------
# WBS/DESIGN/PROTOTYPE are not executed in Phase 1 (see app/orchestrator/state.py
# STAGE_ORDER); Asana/GitHub/Vercel publishing has also been removed from this
# build. These are left here only in case a later phase reintroduces them.
# ASANA_ACCESS_TOKEN=
# ASANA_WORKSPACE_GID=
# GITHUB_TOKEN=
# GITHUB_OWNER=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
