{
  "display_information": {
    "name": "PM Agent",
    "description": "Turns stakeholder conversation into a plan, work breakdown, design, and prototype",
    "background_color": "#1f2933"
  },
  "features": {
    "bot_user": {
      "display_name": "PM Agent",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/pm",
        "description": "Control the AI project manager",
        "usage_hint": "start | status | cancel",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "chat:write",
        "users:read",
        "commands",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "message.groups",
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
